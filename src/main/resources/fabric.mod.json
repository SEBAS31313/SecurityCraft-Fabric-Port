{
  "schemaVersion": 1,
  "id": "securitycraft",
  "version": "${version}",
  "name": "SecurityCraft \u2014 Fabric port",
  "description": "Fabric adaptation of SecurityCraft 1.10.2.1. Independent Fabric adaptation. Beta build.",
  "authors": [
    "Geforce",
    "bl4ckscor3",
    "Redstone_Dubstep",
    "ChainmailPickaxe"
  ],
  "license": "MIT",
  "environment": "*",
  "icon": "sc_logo.png",
  "entrypoints": {
    "main": [
      "net.geforcemods.securitycraft.SecurityCraft"
    ],
    "client": [
      "net.geforcemods.securitycraft.SecurityCraftClient"
    ],
    "jei_mod_plugin": [
      "net.geforcemods.securitycraft.compat.jei.SCJEIPlugin"
    ],
    "jade": [
      "net.geforcemods.securitycraft.compat.hudmods.JadeDataProvider"
    ]
  },
  "mixins": [
    "securitycraft.mixins.json",
    "securitycraft.fabric-events.mixins.json"
  ],
  "accessWidener": "securitycraft.accesswidener",
  "depends": {
    "minecraft": "26.2",
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.155.2",
    "forgeconfigapiport": ">=26.2.1",
    "java": ">=25"
  }
}
